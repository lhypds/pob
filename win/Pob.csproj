<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pob Windows shell. A feature-for-feature port of the macOS/Linux shells
       built with C# / WPF. See win/README.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pob</AssemblyName>
    <RootNamespace>Pob</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Shared with macOS and Linux — one drawing, three formats, all cut from
         assets/icon/. Embedded in Pob.exe, so the taskbar, alt-tab, Explorer
         and the Start menu shortcut all pick it up without being told. -->
    <ApplicationIcon>../assets/icon/pob.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Allows compiling (not running) this Windows-only app on macOS/Linux,
         e.g. win/build.sh and win/build_docker.sh. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The build scripts override this with -p:Version=<VERSION file>, which
         compiles the version into Pob.exe — an installed copy has no VERSION
         file at a path it can guess. 0.0.0 marks an unstamped build (a plain
         `dotnet build`), which sends AppState.Version to the VERSION file. -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <!-- App.xaml lives under src/, outside the SDK's root-only convention. -->
  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" />
    <Page Remove="src\App.xaml" />
  </ItemGroup>

  <!-- The same icon again, this time as a WPF resource ToolbarWindow can point
       its Icon at. ApplicationIcon above covers Explorer and the Start menu,
       but not the running app: the toolbar is WindowStyle="None", so it has no
       title bar to draw an icon on, and its taskbar button falls back to the
       window class icon rather than the executable's. Setting Window.Icon is
       what puts it in the taskbar and alt-tab. -->
  <ItemGroup>
    <Resource Include="../assets/icon/pob.ico" Link="pob.ico" />
  </ItemGroup>

</Project>
